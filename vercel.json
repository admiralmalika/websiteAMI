{
  "version": 2,
  "name": "admiral-malika",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "store.admiralmalika.com"
        }
      ],
      "dest": "/online-store/$1"
    },
    {
      "src": "/online-store(.*)",
      "status": 301,
      "headers": {
        "Location": "https://store.admiralmalika.com"
      }
    },
    {
      "src": "/store(.*)",
      "status": 301,
      "headers": {
        "Location": "https://store.admiralmalika.com"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/company-profile/$1"
    }
  ]
}
