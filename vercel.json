{
  "version": 2,
  "name": "admiral-malika",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/online-store/(.*)",
      "dest": "/online-store/$1"
    },
    {
      "src": "/online-store",
      "dest": "/online-store/index.html"
    },
    {
      "src": "/store/(.*)",
      "dest": "/online-store/$1"
    },
    {
      "src": "/store",
      "dest": "/online-store/index.html"
    },
    {
      "src": "/css/store.css",
      "dest": "/online-store/css/store.css"
    },
    {
      "src": "/js/store.js",
      "dest": "/online-store/js/store.js"
    },
    {
      "src": "/images/(.*)",
      "dest": "/online-store/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/company-profile/$1"
    }
  ]
}
