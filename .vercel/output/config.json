{
  "version": 3,
  "routes": [
    {
      "src": "^/(?:(.+)/)?index(?:\\.html)?/?$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "^/(.*)\\.html/?$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "^/(.*)/$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "^/online-store$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/online-store(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/store$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/store(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404"
    }
  ],
  "overrides": {
    "company-profile/admin/agraria-admin.html": {
